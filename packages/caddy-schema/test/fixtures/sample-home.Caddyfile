prox.example.com {
    reverse_proxy * {
        to https://10.0.0.1:8006

        lb_policy ip_hash
        health_uri /
        health_interval 10s
        health_timeout 2s

        transport http {
            tls_insecure_skip_verify
            tls_server_name prox.example.com
        }

        # Critical for noVNC and terminal consoles
        header_up Upgrade {http.request.header.Upgrade}
        header_up Connection {http.request.header.Connection}
    }
}   

px.example.net {
  reverse_proxy 10.0.0.101:11002
}

router.example.com {
        reverse_proxy 10.0.0.5:80
}

rp.example.org {
        reverse_proxy 10.0.0.100:30080
}

safe.example.com {
    #import tinyauth_forwarder

    handle /u/* {
        # Capture username: first segment after /u/
        @username path_regexp ^/u/([^/]+)(.*)$

        # Specific: /u/<username>/p → /user/<username>/priv
        redir /u/{path.1}/p /users/{path.1}/priv 302

        # Specific: /u/<username>/p/* → /user/<username>/priv/*
        @pstuff path_regexp ^/u/([^/]+)/p/(.*)$
        redir @pstuff /users/{re.pstuff.1}/priv/{re.pstuff.2} 302

        # Generic catch-all: all other /u/<username>/* → /user/<username>/*
        redir @username /users/{re.username.1}{re.username.2} 302
    }

    # Reverse Proxy for all other requests to 10.0.0.102:3923
    reverse_proxy 10.0.0.102:3923
    #reverse_proxy 10.0.0.102:3923 {
    #}
}

