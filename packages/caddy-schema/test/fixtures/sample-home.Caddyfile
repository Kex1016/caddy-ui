{
        servers {
                trusted_proxies static 10.0.0.103
        }
        admin 0.0.0.0:2019
        email admin@example.com
}

(tinyauth_forwarder) {
        forward_auth 10.0.0.103:8888 {
                uri /api/auth/caddy
                copy_headers Remote-User Remote-Name Remote-Email Remote-Groups
        }
}

asuka.example.club {
        reverse_proxy 10.0.0.106:8888
}

asuka.example.com {
  redir https://asuka.example.club{uri} permanent
}

auth.example.com {
        reverse_proxy 10.0.0.101:8888
}

me.example.com {
        reverse_proxy 10.0.0.103:11081
}

cow.example.org {
        redir https://github.com/example-org
}

d.in.example.net {
  reverse_proxy 10.0.0.101:11003
  rewrite * ?direct=true
}

downloads.example.com {
  redir https://safe.example.com/downloads{uri} permanent
}

fishnet.example.com {
        reverse_proxy 10.0.0.103:7777
}

g.in.example.net {
  reverse_proxy 10.0.0.101:11003
  rewrite * ?gallery=true
}

grimoire.example.com {
        handle {
                reverse_proxy 10.0.0.103:5173
        }
        handle_errors {
                try_files {path} /usr/share/caddy/invalid_site/index.html
                file_server
        }
}

example.com, www.example.com {
      @protected path /edit* /preview* /admin*
      @project path /~user/project/me /~user/project/raw /~user/project/img/*

      redir /~user/project/archive /~user/project/archive/ 308

      handle /~user/project/archive/* {
        route {
          forward_auth 10.0.0.101:8888 {
            uri /api/auth/caddy
            copy_headers Remote-User Remote-Name Remote-Email Remote-Groups
          }
          uri strip_prefix /~user/project/archive
          reverse_proxy 10.0.0.103:8788
        }
      }

      handle @project {
        uri strip_prefix /~user/project
        reverse_proxy 10.0.0.103:8787
      }

      handle {
          forward_auth @protected 10.0.0.101:8888 {
              uri /api/auth/caddy
              copy_headers Remote-User Remote-Name Remote-Email Remote-Groups
        }
        reverse_proxy 10.0.0.103:3000
      }
}

